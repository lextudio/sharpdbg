<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Normally passed by OpenDevelop's Directory.Packages.props from the local feed. -->
    <LextudioDapForkVersion Condition="'$(LextudioDapForkVersion)' == ''">1.0.0-lextudio.42043402458.1</LextudioDapForkVersion>
  </PropertyGroup>

	<ItemGroup>
		<!-- The DAP transport is the MIT-licensed OmniSharp fork, the same one SharpDbg.AndroidAgent
		     uses. Microsoft.VisualStudio.Shared.VSCodeDebugProtocol is deliberately not referenced:
		     its package license is not open source and cannot be redistributed with OpenDevelop. -->
		<PackageReference Include="OmniSharp.Extensions.DebugAdapter.Server" Version="[$(LextudioDapForkVersion)]" />
		<PackageReference Include="OmniSharp.Extensions.DebugAdapter.Shared" Version="[$(LextudioDapForkVersion)]" />
		<PackageReference Include="OmniSharp.Extensions.DebugAdapter" Version="[$(LextudioDapForkVersion)]" />
		<PackageReference Include="OmniSharp.Extensions.JsonRpc" Version="[$(LextudioDapForkVersion)]" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpDbg.Infrastructure\SharpDbg.Infrastructure.csproj" />
  </ItemGroup>

</Project>
